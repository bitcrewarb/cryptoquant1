# CRYPTO QUANT LAB Environment Configuration
# Copy to .env for local development or Docker Compose deployment.

# Application
APP_NAME="CRYPTO QUANT LAB"
APP_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="INFO"

# Security & Authentication
# Generate strong random keys for production (e.g., python3 -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=""
CREDENTIALS_ENCRYPTION_KEY=""
ADMIN_PASSCODE=""

# Database (Defaults to local SQLite in data_store/cql.db if unset; use PostgreSQL/TimescaleDB in production)
DATABASE_URL=""
DATA_STORE_DIR="./data_store"

# Background Processing (Optional Redis/Celery; uses persistent in-process worker fallback when unset)
REDIS_URL=""
CELERY_BROKER_URL=""
CELERY_RESULT_BACKEND=""

# Exchange Public Endpoints (Binance Spot & USDT-M Futures)
BINANCE_SPOT_BASE_URL="https://api.binance.com"
BINANCE_FUTURES_BASE_URL="https://fapi.binance.com"
BINANCE_WS_SPOT_URL="wss://stream.binance.com:9443/ws"
BINANCE_WS_FUTURES_URL="wss://fstream.binance.com/ws"

# Optional Live Trading Credentials (DISABLED BY DEFAULT - never required for research or paper trading)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
LIVE_TRADING_ENABLED="false"
